# homdu.pl — czyste adresy URL (bez .html)
RewriteEngine On

# 1) /index lub /index.html  ->  /   (301)
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) /cokolwiek.html  ->  /cokolwiek   (301 — usuwa .html z paska adresu)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Wewnętrznie serwuj /cokolwiek z pliku cokolwiek.html (jeśli istnieje)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
